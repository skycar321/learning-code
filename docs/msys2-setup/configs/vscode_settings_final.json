{
    // ============================================================================
    // VS Code 완전한 설정 (터미널 이름 표시 수정)
    // ============================================================================

    // 기본 터미널 프로필
    "terminal.integrated.defaultProfile.windows": "MSYS2 UCRT64",

    // 터미널 프로필 정의
    "terminal.integrated.profiles.windows": {
        "MSYS2 UCRT64": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "MSYSTEM": "UCRT64",
                "CHERE_INVOKING": "1",
                "MSYS2_PATH_TYPE": "inherit"
            },
            "icon": "terminal-bash",
            "color": "terminal.ansiBlue",
            "overrideName": true
        },
        "MSYS2 MINGW64": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "MSYSTEM": "MINGW64",
                "CHERE_INVOKING": "1",
                "MSYS2_PATH_TYPE": "inherit"
            },
            "icon": "terminal-bash",
            "color": "terminal.ansiGreen",
            "overrideName": true
        },
        "Git Bash": {
            "path": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "icon": "terminal-bash",
            "color": "terminal.ansiGreen",
            "overrideName": true
        },
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "color": "terminal.ansiCyan",
            "overrideName": true
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "icon": "terminal-cmd",
            "color": "terminal.ansiYellow",
            "overrideName": true
        }
    },

    // ============================================================================
    // 터미널 탭 제목 설정 (핵심!)
    // ============================================================================
    // IMPORTANT: 터미널 탭에 프로필 이름(MSYS2 UCRT64)을 표시하려면
    // title 설정을 주석 처리하고 overrideName: true를 사용하세요

    // 옵션 1: 프로필 이름만 표시 (추천) ⭐
    // "terminal.integrated.tabs.title" 주석 처리 + "overrideName": true 사용
    // 결과: "MSYS2 UCRT64" 표시
    "terminal.integrated.tabs.description": "${cwdFolder}",

    // 옵션 2: 프로세스 이름 표시 (주석 해제하여 사용)
    // "terminal.integrated.tabs.title": "${process}",
    // 결과: "bash" 표시

    // 옵션 3: 상세 정보 표시 (주석 해제하여 사용)
    // "terminal.integrated.tabs.title": "${process} ${separator} ${task}",
    // "terminal.integrated.tabs.description": "${cwdFolder}",

    // 옵션 4: 아이콘 추가 (주석 해제하여 사용)
    // "terminal.integrated.tabs.title": "⚡ ${process}",
    // "terminal.integrated.tabs.description": "${task} | ${cwdFolder}",

    "terminal.integrated.tabs.separator": " - ",
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.location": "right",
    "terminal.integrated.tabs.showActiveTerminal": "always",
    "terminal.integrated.tabs.showActions": "always",

    // ============================================================================
    // 터미널 폰트 및 스타일
    // ============================================================================

    "terminal.integrated.fontFamily": "MesloLGS NF, 'Cascadia Code', Consolas",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.lineHeight": 1.2,

    // 커서 설정
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorWidth": 2,

    // ============================================================================
    // 터미널 동작 설정
    // ============================================================================

    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.rightClickBehavior": "default",
    "terminal.integrated.splitCwd": "workspaceRoot",
    "terminal.integrated.confirmOnExit": "hasChildProcesses",
    "terminal.integrated.confirmOnKill": "editor",

    // 터미널 환경변수
    "terminal.integrated.env.windows": {
        "LANG": "ko_KR.UTF-8",
        "LC_ALL": "ko_KR.UTF-8"
    },

    // ============================================================================
    // Git 설정
    // ============================================================================

    "git.path": "C:\\msys64\\usr\\bin\\git.exe",
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.ignoreMissingGitWarning": false,

    // ============================================================================
    // 파일 설정
    // ============================================================================

    "files.autoGuessEncoding": true,
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.encoding": "utf8",

    // Shell 스크립트 파일 연결
    "files.associations": {
        "*.sh": "shellscript",
        ".bashrc": "shellscript",
        ".bash_profile": "shellscript",
        ".zshrc": "shellscript",
        ".zsh_history": "shellscript",
        ".p10k.zsh": "shellscript",
        "*.zsh": "shellscript"
    },

    // ============================================================================
    // 편집기 설정 (선택사항)
    // ============================================================================

    "editor.fontSize": 14,
    "editor.fontFamily": "'Cascadia Code', 'Fira Code', 'MesloLGS NF', Consolas, monospace",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": true,
    "editor.wordWrap": "on",
    "editor.formatOnSave": true,
    "editor.renderWhitespace": "boundary",
    "editor.rulers": [80, 120],

    // ============================================================================
    // 확장 프로그램 설정
    // ============================================================================

    "claudeCode.preferredLocation": "panel",
    "geminicodeassist.project": "perfect-ranger-dkhfj",

    // ============================================================================
    // 작업 공간 설정 (선택사항)
    // ============================================================================

    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "vs-seti",
    "workbench.startupEditor": "welcomePage",
    "workbench.editor.enablePreview": false
}
