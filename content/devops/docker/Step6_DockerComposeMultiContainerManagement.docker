# Docker Step 6: Docker Compose를 이용한 다중 컨테이너 관리
# `docker-compose.yml` 파일 작성, 서비스 정의, 다중 컨테이너 애플리케이션 실행

# 나쁜 예시: 여러 컨테이너로 구성된 애플리케이션을 `docker run` 명령어를 반복하여 수동으로 실행하고 관리하여 비효율적이고 오류 발생 가능성 높음.
# 좋은 예시: `docker-compose.yml` 파일을 사용하여 전체 애플리케이션 스택을 단일 파일로 정의하고, 간단한 명령어로 모든 서비스를 시작, 중지, 빌드, 관리.

# 학습 포인트: Docker Compose는 여러 개의 Docker 컨테이너로 구성된 애플리케이션을 정의하고 실행하기 위한 도구입니다. 복잡한 다중 컨테이너 환경을 효율적으로 관리할 수 있습니다.

# --- 1. Docker Compose 설치 ---
# - Docker Desktop을 설치하면 Docker Compose가 함께 설치됩니다.
# - Linux 환경에서는 별도로 설치해야 할 수 있습니다. (`sudo apt install docker-compose`)

# --- 2. `docker-compose.yml` 파일 작성 ---
# `docker-compose.yml` 파일은 YAML 형식으로 작성되며, 애플리케이션의 서비스, 네트워크, 볼륨 등을 정의합니다.

# 예시: 웹 애플리케이션 (Node.js) + 데이터베이스 (MongoDB) 스택을 위한 `docker-compose.yml`
# (docker-compose.yml)
/*
version: '3.8' # Compose 파일 형식 버전

services: # 애플리케이션을 구성하는 서비스들을 정의합니다.
  webapp: # 웹 애플리케이션 서비스
    build: . # 현재 디렉토리의 Dockerfile을 사용하여 이미지를 빌드합니다. (Docker Compose는 Dockerfile이 있는 디렉토리를 context로 사용)
    ports:
      - "3000:3000" # 호스트의 3000번 포트를 컨테이너의 3000번 포트에 연결합니다.
    volumes:
      - ./webapp:/app # 호스트의 ./webapp 디렉토리를 컨테이너의 /app 디렉토리에 마운트합니다. (개발 환경에서 코드 변경 사항 반영)
    depends_on: # 이 서비스가 시작되기 전에 의존하는 서비스들이 시작되도록 합니다.
      - mongodb
    environment: # 컨테이너 내부에 환경 변수를 설정합니다.
      NODE_ENV: development
      MONGO_URI: mongodb://mongodb:27017/mydatabase # MongoDB 컨테이너 이름으로 접근 가능 (동일 네트워크)

  mongodb: # MongoDB 데이터베이스 서비스
    image: mongo:latest # mongo 이미지를 사용합니다.
    ports:
      - "27017:27017" # MongoDB 클라이언트를 위해 포트 노출 (선택 사항)
    volumes:
      - mongodb_data:/data/db # 'mongodb_data'라는 명명된 볼륨을 데이터 저장에 사용합니다.

networks: # 사용자 정의 네트워크 (선택 사항, Compose는 기본적으로 프로젝트 이름을 딴 네트워크를 생성)
  default:
    driver: bridge

volumes: # 명명된 볼륨을 정의합니다.
  mongodb_data: # mongodb 데이터를 저장할 볼륨
*/

# --- 3. 서비스 정의 세부 사항 ---
# - `image`: 사용할 Docker 이미지 (예: `nginx:latest`, `node:18-alpine`)
# - `build`: Dockerfile이 있는 경로를 지정하여 이미지를 빌드합니다.
# - `ports`: 호스트와 컨테이너 간의 포트 매핑.
# - `volumes`: 호스트와 컨테이너 간의 볼륨 매핑 (Bind Mounts 또는 Named Volumes).
# - `environment`: 컨테이너 내부의 환경 변수 설정.
# - `depends_on`: 서비스 간의 종속성을 정의합니다. (시작 순서 보장, Health Check까지 보장하지는 않음)
# - `networks`: 컨테이너를 연결할 네트워크 지정. (지정하지 않으면 기본 네트워크에 연결)
# - `command`: 컨테이너 시작 시 실행할 명령어를 재정의합니다.
# - `restart`: 컨테이너 종료 시 재시작 정책 정의 (예: `always`, `on-failure`)

# --- 4. Docker Compose 명령어 ---
# `docker-compose.yml` 파일이 있는 디렉토리에서 다음 명령어를 실행합니다.

# `docker compose build`: `build` 지시어가 있는 서비스의 이미지를 빌드합니다.
# `docker compose up`: `docker-compose.yml` 파일에 정의된 모든 서비스를 백그라운드에서 실행하고 (혹은 `-d` 옵션으로 detached 모드로), 필요한 이미지가 없으면 자동으로 빌드하거나 다운로드합니다.
#   - `docker compose up -d`: 백그라운드에서 모든 서비스를 시작합니다.
# `docker compose down`: `docker-compose.yml` 파일에 정의된 모든 서비스를 중지하고 컨테이너, 네트워크, 볼륨(명명된 볼륨 제외)을 제거합니다.
#   - `docker compose down --volumes`: 명명된 볼륨까지 함께 제거합니다. (데이터 손실 주의)
# `docker compose ps`: 실행 중인 서비스 컨테이너 목록을 확인합니다.
# `docker compose logs`: 모든 서비스의 로그를 확인합니다.
# `docker compose exec <서비스_이름> <명령어>`: 실행 중인 특정 서비스 컨테이너 내부에 명령어를 실행합니다.
#   - 예: `docker compose exec webapp bash` (webapp 컨테이너 셸 접속)

# --- 5. 실습 시나리오 ---
# 1. `docker-compose.yml` 파일을 작성합니다.
# 2. `webapp` 서비스를 위한 `Dockerfile` (Node.js)과 간단한 `index.js` 파일을 생성합니다.
# 3. `docker compose up -d` 명령어로 서비스를 시작합니다.
# 4. 웹 브라우저에서 `http://localhost:3000`에 접속하여 웹 앱을 확인합니다.
# 5. `docker compose down` 명령어로 서비스를 중지합니다.

# 다음 단계에서는 실제 애플리케이션을 Docker 이미지로 만들고 실행하는 실습을 진행합니다.
