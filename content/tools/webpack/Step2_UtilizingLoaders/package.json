// webpack/Step2_UtilizingLoaders/package.json
// Webpack 학습 계획 - 2단계: 로더 (Loaders) 활용
// 이 파일은 다양한 유형의 파일을 처리하기 위한 Webpack 로더 의존성을 정의하는 `package.json` 파일입니다.
// `babel-loader`, `css-loader`, `style-loader`, `sass-loader`, `sass` 등 로더 관련 패키지를 포함합니다.

{
  "name": "step2-utilizing-loaders",
  "version": "1.0.0",
  "description": "Webpack project to learn about different loaders.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "webpack",
    "loaders",
    "babel",
    "css",
    "sass",
    "assets"
  ],
  "author": "Your Name",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.23.0",               // Babel 코어
    "@babel/preset-env": "^7.23.0",          // Babel preset (ES6+를 이전 버전으로 변환)
    "babel-loader": "^9.1.3",                 // Webpack과 Babel 연결
    "css-loader": "^6.8.1",                   // CSS 파일을 JavaScript 모듈로 변환
    "style-loader": "^3.3.3",                 // CSS를 DOM에 주입
    "sass": "^1.69.5",                        // Sass 컴파일러
    "sass-loader": "^13.3.2",                 // Webpack과 Sass 연결
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.5.3"           // HTML 파일 생성 및 번들 삽입 플러그인
  }
}

/*
이 코드를 실행하려면:

1. Node.js 및 npm 설치.
2. `webpack/Step2_UtilizingLoaders` 디렉토리를 생성하고 이 파일을 `package.json`으로 저장.
3. `webpack/Step2_UtilizingLoaders` 디렉토리에 `webpack.config.js`, `src/index.js`, `src/index.html`, `src/style.css`, `src/style.scss`, `src/image.png`, `src/font.ttf` 파일 생성.
4. 터미널에서 `webpack/Step2_UtilizingLoaders` 디렉토리로 이동.
5. `npm install` 명령을 실행하여 `package.json`에 정의된 개발 의존성 설치.
6. `npm start` 명령으로 개발 서버 시작.
7. `npm run build` 명령으로 프로덕션 빌드.
*/
