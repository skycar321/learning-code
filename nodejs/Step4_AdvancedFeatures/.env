# nodejs/Step4_AdvancedFeatures/.env
# Node.js 학습 계획 - 4단계: 고급 기능 및 모범 사례
# 이 파일은 `dotenv` 라이브러리를 사용하여 로드될 환경 변수를 정의하는 `.env` 파일입니다.
#
# 환경 변수는 애플리케이션의 설정값을 코드 외부에 저장하여
# 환경별(개발, 운영 등)로 다르게 적용하거나, 민감한 정보를 안전하게 관리하는 데 사용됩니다.

PORT=3000
NODE_ENV=development
API_KEY=your_super_secret_api_key_12345
# 나쁜 예시: API 키, 데이터베이스 비밀번호와 같은 민감한 정보를 Git Repository에 직접 커밋하는 것.
# - 보안에 매우 취약하며, 민감 정보가 외부에 노출될 수 있습니다.
# - `.env` 파일은 `.gitignore`에 추가하여 Git 추적에서 제외해야 합니다.
# - 운영 환경에서는 `.env` 파일 대신 클라우드 서비스의 Secret 관리 기능을 사용하거나
#   컨테이너 환경에서 직접 환경 변수를 주입해야 합니다.
