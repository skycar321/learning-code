# nodejs/Step5_DeploymentAndMicroservices/Dockerfile
# Node.js 학습 계획 - 5단계: 배포 및 마이크로서비스
# 이 파일은 Node.js 애플리케이션을 Docker 이미지로 빌드하고 컨테이너화하는 방법을 보여주는 `Dockerfile`입니다.
#
# Docker를 이용한 컨테이너화는 애플리케이션을 격리된 환경에서 일관되게 실행하고,
# 다양한 환경(개발, 테스트, 운영)에 걸쳐 이식성을 보장하는 데 필수적입니다.

# -----------------------------------------------------------------------------
# 학습 포인트 1: Node.js Docker 이미지 선택
# - `node:<version>-alpine`: 경량 Alpine Linux 기반 이미지. 작은 이미지 크기로 배포에 유리.
# - `node:<version>-slim`: Debian 기반의 최소 이미지. Alpine보다 조금 크지만 특정 라이브러리 호환성 좋음.
# - `node:<version>`: 전체 Node.js 환경. 디버깅 및 개발에 유용하지만 이미지 크기가 큼.
# -----------------------------------------------------------------------------
FROM node:18-alpine AS builder # Node.js 18 버전의 Alpine Linux 기반 이미지를 빌더 스테이지로 사용

# -----------------------------------------------------------------------------
# 학습 포인트 2: 다단계 빌드 (Multi-stage Builds)
# - 여러 `FROM` 문을 사용하여 빌드 프로세스를 여러 단계로 분리합니다.
# - 첫 번째 단계(builder)에서는 의존성을 설치하고 애플리케이션을 빌드합니다.
# - 두 번째 단계(runner)에서는 첫 번째 단계의 빌드 결과만 가져와 최종 이미지를 만듭니다.
# - 이미지 크기를 최소화하고 불필요한 개발 도구를 최종 이미지에 포함하지 않아 보안을 강화합니다.
# -----------------------------------------------------------------------------

WORKDIR /app # 컨테이너 내부의 작업 디렉토리 설정

# `package.json`과 `package-lock.json`을 복사하여 의존성만 먼저 설치 (캐싱 활용)
COPY package*.json ./

# 나쁜 예시: `COPY . .` 명령으로 모든 파일을 복사한 후 `npm install`을 실행하는 것.
# - 코드 변경 시 `npm install`이 항상 다시 실행되어 빌드 시간이 길어집니다.
# - `package*.json`만 먼저 복사하여 의존성 레이어를 캐싱하는 것이 효율적입니다.
RUN npm install --omit=dev # 개발 의존성은 최종 이미지에 포함하지 않음

# 애플리케이션 소스 코드 복사
COPY . .

# -----------------------------------------------------------------------------
# 학습 포인트 3: `EXPOSE` 지시어
# - 컨테이너가 특정 포트를 통해 들어오는 연결을 수신 대기할 것임을 문서화합니다.
# - `docker run -p` 옵션과 함께 사용되어야 실제 포트 매핑이 일어납니다.
# -----------------------------------------------------------------------------
EXPOSE 3000

# -----------------------------------------------------------------------------
# 학습 포인트 4: `CMD` 지시어
# - 컨테이너가 시작될 때 실행될 기본 명령어를 지정합니다.
# - `CMD ["node", "server.js"]`와 같이 배열 형태로 사용하는 것이 좋습니다 (exec form).
# -----------------------------------------------------------------------------
CMD ["node", "server.js"]

/*
이 Dockerfile을 사용하여 Node.js 애플리케이션을 빌드하고 실행하려면:

1. `package.json`, `server.js` 파일과 함께 `nodejs/Step5_DeploymentAndMicroservices` 디렉토리를 생성.
2. `Dockerfile` 파일을 이 파일의 내용으로 저장.
3. 터미널에서 `nodejs/Step5_DeploymentAndMicroservices` 디렉토리로 이동.
4. `docker build -t my-nodejs-app:1.0 .` 명령으로 Docker 이미지 빌드.
5. `docker run -p 3000:3000 my-nodejs-app:1.0` 명령으로 컨테이너 실행.
6. 웹 브라우저에서 `http://localhost:3000`으로 접근하여 애플리케이션이 실행되는지 확인.
*/
