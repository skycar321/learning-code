## Codex 생성 결과

```typescript
/**
 * 두 숫자의 합을 계산합니다.
 * @param a - 첫 번째 숫자
 * @param b - 두 번째 숫자
 * @returns 두 숫자의 합
 * @throws {Error} 입력값이 유효하지 않을 때
 * @example
 * addNumbers(1, 2) // 3
 * addNumbers(-1, 1) // 0
 */
export function addNumbers(a: number, b: number): number {
  // 입력 검증
  if (!Number.isFinite(a) || !Number.isFinite(b)) {
    throw new Error("입력값은 유한한 숫자여야 합니다");
  }

  return a + b;
}
```
